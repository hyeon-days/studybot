{
  "name": "study-bot",
  "version": "1.0.0",
  "description": "정기 알림과 음성채널 공부시간 리더보드를 디스코드 안에서 설정하는 스터디봇",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
